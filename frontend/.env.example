# SmartChargeAI Frontend Environment Configuration
# API Base URL (defaults to http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000

# Google Maps Official Demo Key for Prototyping
# If left blank or invalid, the system automatically uses free OpenStreetMap + Leaflet.
VITE_GOOGLE_MAPS_API_KEY=

