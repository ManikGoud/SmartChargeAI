{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "frontend/src/*"
      ]
    }
  },
  "include": [
    "frontend/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "frontend/dist",
    "scratch",
    "scratch/**/*",
    "flowframe",
    "take1framezip",
    "take2frame",
    "take3frame"
  ]
}